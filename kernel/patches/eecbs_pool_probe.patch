diff -ruN '--exclude=build*' src/MemoryPoolProbe.cpp /home/viplab/eecbs/runs/memory_pool_probe_20261020/pooled/src/MemoryPoolProbe.cpp
--- src/MemoryPoolProbe.cpp	1970-01-01 08:00:00.000000000 +0800
+++ /home/viplab/eecbs/runs/memory_pool_probe_20261020/pooled/src/MemoryPoolProbe.cpp	2026-10-20 16:58:57.363781634 +0800
@@ -0,0 +1,212 @@
+#include "MemoryPoolProbe.h"
+
+#include <cerrno>
+#include <cinttypes>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <sys/mman.h>
+#include <time.h>
+#include <unistd.h>
+
+namespace eecbs_pool {
+namespace {
+
+constexpr std::size_t kAlignment = 64;
+constexpr std::uint64_t kMagic = UINT64_C(0x4545434253504f4f);
+const char* const kNames[] = {
+    "AStarNode", "HashTable", "OpenHeap", "FocalHeap", "ConstraintTable", "CAT"
+};
+constexpr unsigned kCount = static_cast<unsigned>(Kind::Count);
+
+struct alignas(kAlignment) Header {
+    Header* next;
+    std::size_t span;
+    std::size_t requested;
+    std::uint64_t magic;
+    unsigned kind;
+};
+static_assert(sizeof(Header) == kAlignment, "pool header must occupy one cache line");
+
+struct Pool {
+    char* base = nullptr;
+    std::size_t capacity = 0;
+    std::size_t cursor = 0;
+    std::map<std::size_t, Header*> free_by_span;
+    std::uint64_t allocs = 0, frees = 0;
+    std::uint64_t live_bytes = 0, peak_live_bytes = 0;
+    std::uint64_t requested_bytes = 0;
+};
+
+Pool pools[kCount];
+bool exit_handler_registered = false;
+bool roi_active = false;
+std::uint64_t roi_start_allocs[kCount] = {};
+std::uint64_t roi_start_frees[kCount] = {};
+
+unsigned index(Kind kind) { return static_cast<unsigned>(kind); }
+
+std::size_t arena_capacity() {
+    const char* env = std::getenv("EECBS_POOL_GIB");
+    if (!env || !*env) return std::size_t(1) << 30;
+    char* end = nullptr;
+    errno = 0;
+    unsigned long gib = std::strtoul(env, &end, 10);
+    if (errno || !end || *end || gib < 1 || gib > 64) {
+        std::fprintf(stderr, "EECBS_POOL_GIB must be an integer from 1 to 64\n");
+        std::abort();
+    }
+    return std::size_t(gib) << 30;
+}
+
+void print_stats() {
+    for (unsigned i = 0; i < kCount; ++i) {
+        const Pool& p = pools[i];
+        if (!p.base) continue;
+        std::fprintf(stderr,
+            "EECBS_POOL_STATS pid=%ld name=%s allocs=%" PRIu64
+            " frees=%" PRIu64 " requested_bytes=%" PRIu64
+            " live_bytes=%" PRIu64 " peak_live_bytes=%" PRIu64
+            " highwater_bytes=%zu\n",
+            static_cast<long>(getpid()), kNames[i], p.allocs, p.frees,
+            p.requested_bytes, p.live_bytes, p.peak_live_bytes, p.cursor);
+    }
+}
+
+Pool& get_pool(Kind kind) {
+    const unsigned i = index(kind);
+    if (i >= kCount) std::abort();
+    Pool& p = pools[i];
+    if (p.base) return p;
+    p.capacity = arena_capacity();
+    int flags = MAP_PRIVATE | MAP_ANONYMOUS;
+#ifdef MAP_NORESERVE
+    flags |= MAP_NORESERVE;
+#endif
+    void* addr = mmap(nullptr, p.capacity, PROT_READ | PROT_WRITE, flags, -1, 0);
+    if (addr == MAP_FAILED) {
+        std::fprintf(stderr, "EECBS pool mmap failed for %s: %s\n", kNames[i], std::strerror(errno));
+        throw std::bad_alloc();
+    }
+    p.base = static_cast<char*>(addr);
+    if (!exit_handler_registered) {
+        std::atexit(print_stats);
+        exit_handler_registered = true;
+    }
+    std::fprintf(stderr, "EECBS_POOL_RANGE pid=%ld name=%s begin=0x%" PRIxPTR
+                         " end=0x%" PRIxPTR "\n",
+        static_cast<long>(getpid()), kNames[i],
+        reinterpret_cast<std::uintptr_t>(p.base),
+        reinterpret_cast<std::uintptr_t>(p.base + p.capacity));
+    return p;
+}
+
+std::size_t rounded_span(std::size_t requested) {
+    if (requested > SIZE_MAX - sizeof(Header) - (kAlignment - 1))
+        throw std::bad_alloc();
+    const std::size_t total = sizeof(Header) + (requested ? requested : 1);
+    return (total + kAlignment - 1) & ~(kAlignment - 1);
+}
+
+double monotonic_seconds() noexcept {
+    timespec ts{};
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return static_cast<double>(ts.tv_sec) + static_cast<double>(ts.tv_nsec) / 1e9;
+}
+
+void reserve_all_pools() noexcept {
+    for (unsigned i = 0; i < kCount; ++i) (void)get_pool(static_cast<Kind>(i));
+}
+void write_ranges_file() noexcept {
+    std::FILE* f = std::fopen("eecbs_pool_ranges.txt", "w");
+    if (!f) return;
+    for (unsigned i = 0; i < kCount; ++i) {
+        const Pool& pp = pools[i];
+        if (!pp.base) continue;
+        std::fprintf(f, "%s 0x%" PRIxPTR " 0x%" PRIxPTR "\n", kNames[i],
+            reinterpret_cast<std::uintptr_t>(pp.base),
+            reinterpret_cast<std::uintptr_t>(pp.base + pp.capacity));
+    }
+    std::fclose(f);
+}
+} // namespace
+
+void* allocate(Kind kind, std::size_t bytes) {
+    Pool& p = get_pool(kind);
+    const std::size_t span = rounded_span(bytes);
+    p.free_by_span.emplace(span, nullptr); // deallocation must not allocate
+    Header* h = nullptr;
+    auto it = p.free_by_span.find(span);
+    if (it != p.free_by_span.end() && it->second) {
+        h = it->second;
+        it->second = h->next;
+    } else {
+        if (span > p.capacity - p.cursor) {
+            std::fprintf(stderr, "EECBS pool %s exhausted (highwater=%zu bytes); "
+                                 "increase EECBS_POOL_GIB\n", kNames[index(kind)], p.cursor);
+            throw std::bad_alloc();
+        }
+        h = reinterpret_cast<Header*>(p.base + p.cursor);
+        p.cursor += span;
+    }
+    h->next = nullptr;
+    h->span = span;
+    h->requested = bytes;
+    h->magic = kMagic;
+    h->kind = index(kind);
+    ++p.allocs;
+    p.requested_bytes += bytes;
+    p.live_bytes += bytes;
+    if (p.live_bytes > p.peak_live_bytes) p.peak_live_bytes = p.live_bytes;
+    return reinterpret_cast<char*>(h) + sizeof(Header);
+}
+
+void deallocate(Kind kind, void* ptr) noexcept {
+    if (!ptr) return;
+    const unsigned i = index(kind);
+    if (i >= kCount || !pools[i].base) std::abort();
+    Pool& p = pools[i];
+    const auto address = reinterpret_cast<std::uintptr_t>(ptr);
+    const auto begin = reinterpret_cast<std::uintptr_t>(p.base);
+    if (address < begin + sizeof(Header) || address >= begin + p.cursor)
+        std::abort();
+    Header* h = reinterpret_cast<Header*>(static_cast<char*>(ptr) - sizeof(Header));
+    if (h->magic != kMagic || h->kind != i) std::abort();
+    h->magic = 0;
+    ++p.frees;
+    p.live_bytes -= h->requested;
+    auto it = p.free_by_span.find(h->span);
+    if (it == p.free_by_span.end()) std::abort();
+    h->next = it->second;
+    it->second = h;
+}
+
+void roi_begin() noexcept {
+    roi_active = true;
+    reserve_all_pools();
+    write_ranges_file();
+    for (unsigned i = 0; i < kCount; ++i) {
+        roi_start_allocs[i] = pools[i].allocs;
+        roi_start_frees[i] = pools[i].frees;
+    }
+    std::fprintf(stderr, "EECBS_POOL_ROI_BEGIN pid=%ld time=%.9f\n",
+                 static_cast<long>(getpid()), monotonic_seconds());
+}
+
+void roi_end() noexcept {
+    std::fprintf(stderr, "EECBS_POOL_ROI_END pid=%ld time=%.9f\n",
+                 static_cast<long>(getpid()), monotonic_seconds());
+    if (!roi_active) return;
+    for (unsigned i = 0; i < kCount; ++i) {
+        if (!pools[i].base) continue;
+        std::fprintf(stderr, "EECBS_POOL_ROI_ALLOC pid=%ld name=%s allocs=%" PRIu64
+                             " frees=%" PRIu64 "\n", static_cast<long>(getpid()), kNames[i],
+                     pools[i].allocs - roi_start_allocs[i],
+                     pools[i].frees - roi_start_frees[i]);
+    }
+    roi_active = false;
+}
+
+} // namespace eecbs_pool
